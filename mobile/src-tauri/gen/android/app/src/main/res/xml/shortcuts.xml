<?xml version="1.0" encoding="utf-8"?>
<!--
  Raccourcis d'appui long sur l'icône. Volontairement STATIQUES : des raccourcis par serveur
  (« Redémarrer X ») seraient plus utiles, mais demandent un ShortcutManager alimenté depuis Rust
  ET une chaîne de liens profonds que l'app n'a pas encore (le webview ne lit pas l'intent
  d'ouverture). À faire quand cette chaîne existera.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
    android:shortcutId="servers"
    android:enabled="true"
    android:icon="@mipmap/ic_launcher"
    android:shortcutShortLabel="@string/shortcut_servers_short"
    android:shortcutLongLabel="@string/shortcut_servers_long">
    <intent
      android:action="android.intent.action.MAIN"
      android:targetPackage="com.geoffreylecoq.minestratorterminal"
      android:targetClass="com.geoffreylecoq.minestratorterminal.MainActivity" />
  </shortcut>
</shortcuts>
