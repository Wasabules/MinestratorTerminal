{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/build-daemon-sidecar.mjs"
  },
  "bundle": {
    "externalBin": ["binaries/minestrator-daemon"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "postInstallScript": "./linux/deb-postinst.sh",
        "preRemoveScript": "./linux/deb-prerm.sh",
        "postRemoveScript": "./linux/deb-postrm.sh"
      },
      "rpm": {
        "postInstallScript": "./linux/rpm-post.sh",
        "preRemoveScript": "./linux/rpm-preun.sh"
      }
    }
  }
}
